# ── Blockchain Data (Alchemy or Moralis) ─────────────────────────
# Free API key at: https://dashboard.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here
# Optional fallback (Moralis)
MORALIS_API_KEY=your_moralis_api_key_here

# ── AI Analysis ──────────────────────────────────────────────────
# Free API key at: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# ── Telegram Bot ─────────────────────────────────────────────────
# 1. Open Telegram → search @BotFather → send /newbot
# 2. Follow prompts: Name = "TreasuryWizard", Username = "@TreasuryWizardBot"
# 3. BotFather returns a token like: 7123456789:AAF_xxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID (operator notifications land here)
# How to find it:
#   1. Send any message to your bot
#   2. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   3. Copy the "id" value from the "chat" object
TELEGRAM_OPERATOR_CHAT_ID=your_numeric_chat_id_here

# ── Database (Neon Serverless Postgres) ──────────────────────────
# 1. Create free project at: https://console.neon.tech
# 2. Click "Connect" → copy the connection string
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Lead Funnel ───────────────────────────────────────────────────
# Your Calendly 15-min booking page URL
# Create at: https://calendly.com → New Event Type → 15 Minutes
CALENDLY_URL=https://calendly.com/yourname/15min

# ── App Config ───────────────────────────────────────────────────
# Your public deployment URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://walletlens.xyz

# Webhook secret — any random string, used to verify Telegram sends
# Generate one: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here
